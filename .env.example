# ──────────────────────────────────────────────────────────────────────────
# MinIO — Environment variables
# Copy this file to `.env` and override whatever you need.
# Commented variables show their default value.
# UNcommented variables are REQUIRED (no safe default).
# ──────────────────────────────────────────────────────────────────────────

# ─── Image ────────────────────────────────────────────────────────────────
# MINIO_IMAGE=minio/minio
# MINIO_VERSION=RELEASE.2025-01-20T14-49-07Z
# MC_IMAGE=minio/mc
# MC_VERSION=RELEASE.2025-01-17T23-25-50Z

# ─── Root credentials (REQUIRED) ──────────────────────────────────────────
# Admin user and password. Password ≥ 20 characters recommended.
MINIO_ROOT_USER=changeme_admin
MINIO_ROOT_PASSWORD=changeme_super_secret_min_20_chars

# ─── Host-exposed ports ───────────────────────────────────────────────────
# Bound to loopback by default — change to 0.0.0.0:9000 to expose on LAN.
# MINIO_API_PORT=127.0.0.1:9000
# MINIO_CONSOLE_PORT=127.0.0.1:9001

# ─── Public URLs (needed if behind reverse proxy / TLS) ───────────────────
# Leave empty if accessing directly by IP/port on LAN.
# MINIO_SERVER_URL=https://s3.example.com
# MINIO_BROWSER_REDIRECT_URL=https://console.s3.example.com

# ─── Region and behavior ──────────────────────────────────────────────────
# MINIO_REGION=us-east-1
# MINIO_BROWSER=on
# MINIO_DOMAIN=

# ─── Observability ────────────────────────────────────────────────────────
# `public` allows scraping without a token (recommended behind a private net).
# Alternative: `jwt`, token generated via `mc admin prometheus generate`.
# MINIO_PROMETHEUS_AUTH_TYPE=public
# MINIO_PROMETHEUS_URL=
# MINIO_PROMETHEUS_JOB_ID=minio-job

# ─── Host path for the 4 drives (erasure coding EC:2) ─────────────────────
# Ideally each on a distinct physical disk. On a single pragmatic host they
# can share the same FS, but you lose physical-disk fault tolerance.
# MINIO_DATA_PATH=/srv/minio

# ─── Network MTU ──────────────────────────────────────────────────────────
# Lower (e.g. 1450) if running over VPN/overlay with smaller MTU upstream.
# NETWORK_MTU=1500

# ─── Shared external network (consumer stacks attach here) ────────────────
# Must be created beforehand:
#   docker network create --driver bridge \
#     --opt com.docker.network.driver.mtu=1500 minio_router
# MINIO_ROUTER_NETWORK=minio_router

# ─── Resources: reservation (guaranteed) and limit (ceiling) ──────────────
# MINIO_CPU_RESERVATION=1
# MINIO_MEM_RESERVATION=1g
# MINIO_CPU_LIMIT=2
# MINIO_MEM_LIMIT=2g

# ─── Initial bootstrap (`mc-init` service, runs once) ─────────────────────
# Bucket created on first start. Leave empty to skip.
# INIT_BUCKET=app-data
# INIT_BUCKET_POLICY=none
# Valid policy values: none | download | upload | public

# ─── Compose project name (optional) ──────────────────────────────────────
# COMPOSE_PROJECT_NAME=minio
